# Copie para .env.local (desenvolvimento) e cadastre as mesmas chaves na Vercel (produção).
# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Chave de serviço: só no servidor (scripts de carga e tarefas administrativas). Nunca no navegador.
SUPABASE_SERVICE_ROLE_KEY=

# Asaas (etapa 3). Chave de API da conta do escritório: Asaas → Integrações → API. Só no servidor.
ASAAS_API_KEY=
# sandbox (testes, https://sandbox.asaas.com) ou production
ASAAS_ENV=sandbox
# Token que você define no painel do Asaas ao cadastrar o webhook (Integrações → Webhooks). Mínimo 8 caracteres.
ASAAS_WEBHOOK_TOKEN=
# Opcional: sobrescreve a URL base da API (padrão: api-sandbox.asaas.com/v3 ou api.asaas.com/v3)
# ASAAS_BASE_URL=

# WhatsApp oficial (Meta Cloud API). Tudo só no servidor.
# Token permanente de usuário do sistema (Meta Business → Usuários do sistema → gerar token com whatsapp_business_messaging).
WHATSAPP_TOKEN=
# ID do número de telefone (WhatsApp → Configuração da API → "Identificação do número de telefone").
WHATSAPP_PHONE_NUMBER_ID=
# Token de verificação que você inventa e repete ao cadastrar o webhook no app da Meta.
WHATSAPP_VERIFY_TOKEN=
# Chave secreta do app (Meta for Developers → Configurações do app → Básico → Chave Secreta). Valida a assinatura do webhook.
WHATSAPP_APP_SECRET=
# true liga os lembretes automáticos da régua (cron dias úteis 9h). Sem isso o cron só simula.
WHATSAPP_REGUA_AUTOMATICA=false
# Segredo do cron da Vercel (Settings → Environment Variables; a Vercel envia como Authorization: Bearer).
CRON_SECRET=
# Opcional: WHATSAPP_API_VERSION=v21.0 · WHATSAPP_BASE_URL=
# Opcional: id da conta do WhatsApp Business (WABA). Sem ele, o sistema descobre pelo token.
# WHATSAPP_WABA_ID=

# Escala (sistema de gestão do escritório): o "Encaminhar ao judicial" abre o processo lá.
# Token pessoal gerado em https://gestao.gontijofreitas.adv.br/perfil (as escritas saem em nome do dono).
# Sem ele, o encaminhamento funciona e a próxima ação vira "abrir o processo no Escala".
# ESCALA_API_URL=https://gestao.gontijofreitas.adv.br
ESCALA_API_TOKEN=
