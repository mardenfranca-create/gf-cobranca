# Copie para .env.local (desenvolvimento) e cadastre as mesmas chaves na Vercel (produção).
# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Chave de serviço: só no servidor (scripts de carga e tarefas administrativas). Nunca no navegador.
SUPABASE_SERVICE_ROLE_KEY=

# Asaas (etapa 3). Chave de API da conta do escritório: Asaas → Integrações → API. Só no servidor.
ASAAS_API_KEY=
# sandbox (testes, https://sandbox.asaas.com) ou production
ASAAS_ENV=sandbox
# Token que você define no painel do Asaas ao cadastrar o webhook (Integrações → Webhooks). Mínimo 8 caracteres.
ASAAS_WEBHOOK_TOKEN=
# Opcional: sobrescreve a URL base da API (padrão: api-sandbox.asaas.com/v3 ou api.asaas.com/v3)
# ASAAS_BASE_URL=
